BT 1 0 0 1 5 154.4 Tm /F3 7.1 Tf 8.5 TL (    private String[] parseSimpleCsv\(String line\) {) Tj T* (        List<String> fields = new ArrayList<>\(\);) Tj T* (        StringBuilder b = new StringBuilder\(\);) Tj T* (        boolean quoted = false;) Tj T* (        for \(int i = 0; i < line.length\(\); i++\) {) Tj T* (            char c = line.charAt\(i\);) Tj T* (            if \(c == '"'\) {) Tj T* (                if \(quoted && i + 1 < line.length\(\) && line.charAt\(i+1\) == '"'\) {) Tj T* (                    b.append\('"'\); i++;) Tj T* (                } else quoted = !quoted;) Tj T* (            } else if \(c == ',' && !quoted\) {) Tj T* (                fields.add\(b.toString\(\)\); b.setLength\(0\);) Tj T* (            } else b.append\(c\);) Tj T* (        }) Tj T* (        if \(quoted\) return null;) Tj T* (        fields.add\(b.toString\(\)\);) Tj T* (        return fields.toArray\(new String[0]\);) Tj T* (    }) Tj T* (}) Tj T* ET
