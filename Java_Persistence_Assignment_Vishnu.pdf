BT 1 0 0 1 5 188.4 Tm /F3 7.1 Tf 8.5 TL (con.setAutoCommit\(false\);) Tj T* (try \(PreparedStatement ps = con.prepareStatement\() Tj T* (        "INSERT INTO passes\(pass_id, reg_no, name, route, amount\) " +) Tj T* (        "VALUES \(?, ?, ?, ?, ?\)"\)\) {) Tj T* (    int count = 0;) Tj T* (    for \(Pass p : passes\) {) Tj T* (        ps.setString\(1, p.passId\);) Tj T* (        ps.setString\(2, p.regNo\);) Tj T* (        ps.setString\(3, p.name\);) Tj T* (        ps.setInt\(4, p.route\);) Tj T* (        ps.setDouble\(5, p.amount\);) Tj T* (        ps.addBatch\(\);) Tj T* (        count++;) Tj T* (        if \(count % 100 == 0\) ps.executeBatch\(\);) Tj T* (    }) Tj T* (    if \(count % 100 != 0\) ps.executeBatch\(\);) Tj T* (    con.commit\(\);) Tj T* (} catch \(SQLException e\) {) Tj T* (    con.rollback\(\);) Tj T* (    throw e;) Tj T* (} finally {) Tj T* (    con.setAutoCommit\(true\);) Tj T* (}) Tj T* ET
